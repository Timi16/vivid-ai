# Copy to /opt/vivid/.env on the instance. Docker Compose reads this file for
# variable interpolation in docker-compose.prod.yml. It is NOT the backend's
# environment: application config goes in app.env.

# Where the pipeline pushes images. Lowercase, GHCR rejects capitals.
# The deploy job passes this too, so it is a convenience for manual runs.
IMAGE_REPO=ghcr.io/worldstreet-web-services/vivid-ai

# Data-store credentials. Compose refuses to start if these are unset.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Shared secret vivid-tools requires on every browser call. Must match
# VIVID_TOOLS_TOKEN in app.env.
BROWSER_TOKEN=

# Only needed when you run the bundled Caddy (`docker compose --profile edge
# up -d`) on a box that has no web server of its own. Needs a DNS A record
# before the first deploy, or certificate issuance fails. Leave it empty when
# a host Caddy fronts the stack — see deploy/Caddyfile.host.
DOMAIN=

# Where attachment presigned URLs point. The S3v4 signature covers this host,
# so it must be the name the BROWSER uses, not an internal address.
#   bundled Caddy:  https://storage.api.example.com
#   host Caddy:     https://storage.vivid.tsionark.io
S3_PUBLIC_ENDPOINT_URL=https://storage.vivid.tsionark.io

# Port bindings. Loopback keeps both private behind whichever Caddy fronts
# them. Set BACKEND_BIND=0.0.0.0 only to serve :8000 directly with no TLS.
BACKEND_BIND=127.0.0.1
MINIO_BIND=127.0.0.1
