# Copy to /opt/vivid/.env on the instance. Docker Compose reads this file for
# variable interpolation in docker-compose.prod.yml. It is NOT the backend's
# environment: application config goes in app.env.

# Where the pipeline pushes images. Lowercase, GHCR rejects capitals.
# The deploy job passes this too, so it is a convenience for manual runs.
IMAGE_REPO=ghcr.io/worldstreet-web-services/vivid-ai

# Data-store credentials. Compose refuses to start if these are unset.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Shared secret vivid-tools requires on every browser call. Must match
# VIVID_TOOLS_TOKEN in app.env.
BROWSER_TOKEN=

# The hostname Caddy gets a certificate for. Needs a DNS A record pointing at
# this instance's public IP before the first deploy, or issuance fails.
DOMAIN=api.example.com

# Where attachment presigned URLs point. With the Caddyfile's storage host:
S3_PUBLIC_ENDPOINT_URL=https://storage.api.example.com

# Backend port binding. Loopback keeps it private behind Caddy. Set 0.0.0.0
# only if you removed the caddy service and are serving :8000 directly.
BACKEND_BIND=127.0.0.1
