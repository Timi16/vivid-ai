# .env.example — copy to .env and fill in. Never commit .env.

# Shared secret. The pod sends "Authorization: Bearer <this>".
# Generate with: openssl rand -hex 24
# Empty disables auth entirely — dev only; an open browser service is an open proxy.
BROWSER_TOKEN=change-me

# Each browser context holds ~150-250MB. 8 is about right for a 4GB VPS.
BROWSER_MAX_SESSIONS=8

# Seconds of inactivity before a session's context is closed and its memory freed.
BROWSER_SESSION_TTL=600

# Page load timeout in milliseconds.
BROWSER_NAV_TIMEOUT_MS=20000

# Caps on what goes into the model's context window.
BROWSER_MAX_TEXT_CHARS=2000
BROWSER_MAX_ELEMENTS=40

# Leave false. True lets the agent reach 127.0.0.1 and private ranges — which
# means a prompt injection on a web page could read your internal services.
BROWSER_ALLOW_PRIVATE_HOSTS=false