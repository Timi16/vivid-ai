# Copy to .env at the repo root. docker-compose interpolates these into the
# backend and worker containers. All model traffic goes through the backend —
# these URLs must never reach the frontend.

# vLLM OpenAI-compatible root, INCLUDING /v1
# e.g. https://<pod-id>-8000.proxy.runpod.net/v1
LLM_BASE_URL=
LLM_MODEL=RedHatAI/gemma-3-27b-it-quantized.w4a16

# STT server: /transcribe (supports lang=auto) — e.g. https://<pod>-8002.proxy.runpod.net
ASR_BASE_URL=

# TTS server: /speak — e.g. https://<pod>-8003.proxy.runpod.net
# (text cleanup for TTS now lives in the backend, so call it directly)
TTS_BASE_URL=

# MADLAD translate server: /translate — e.g. https://<pod>-8004.proxy.runpod.net
TRANSLATE_BASE_URL=

# Tavily key for the backend tool loop's web_search/news; other tools
# (weather, rates, crypto, wikipedia, calculate, now) need no key.
TAVILY_API_KEY=
# Search cost dials: credits per web_search = SEARCH_QUERY_VARIANTS x
# (2 for advanced, 1 for basic). Defaults: 3 x advanced = 6 credits/search.
TAVILY_SEARCH_DEPTH=advanced
SEARCH_QUERY_VARIANTS=3

# Reranker (BGE-reranker-v2-m3 behind text-embeddings-inference, base URL
# without /rerank) — not deployed yet; leave empty (Tavily's order is used).
# e.g. https://<pod>-8006.proxy.runpod.net
RERANKER_URL=

# Embeddings service — not deployed yet; leave empty (search falls back to
# Postgres full-text).
EMBEDDINGS_URL=

JWT_SECRET=dev-secret-change-me
