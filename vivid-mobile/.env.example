# Base URL of the FastAPI service in vivid-backend. The phone talks to it
# directly (REST + websocket), so on a physical device this must be a LAN IP
# or a tunnel, never localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# "Continue with Google" via Decane Connect. Same project as the web app.
# Register `vivid://auth` as the API key's callback URL in the Decane dashboard,
# otherwise the browser sheet never returns to the app.
EXPO_PUBLIC_DECANE_APP_ID=
EXPO_PUBLIC_DECANE_API_KEY=
