# Base URL of the FastAPI service in vivid-backend. The phone talks to it
# directly (REST + websocket), so on a physical device this must be a LAN IP
# or a tunnel, never localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# "Continue with Google" via Decane Connect. Same Decane project as the web
# app (the backend checks tokens against DECANE_APP_ID), but the mobile app
# needs its OWN API key: a key has one callback URL, and this one must be
# `vivid://auth` so the browser sheet returns to the app.
EXPO_PUBLIC_DECANE_APP_ID=
EXPO_PUBLIC_DECANE_API_KEY=

# Show pages that have no service behind them yet (Computer, Spaces,
# Customize, Discover). Off by default.
EXPO_PUBLIC_PREVIEW_FEATURES=0
